{
	"author": {
		"name": "Oscar Palmér",
		"url": "https://oscarpalmer.se"
	},
	"description": "Dates and stuff.",
	"dependencies": {
		"@oscarpalmer/atoms": "^0.127"
	},
	"devDependencies": {
		"@types/node": "^25",
		"@vitest/coverage-istanbul": "^4",
		"jsdom": "^27.4",
		"oxfmt": "^0.23",
		"oxlint": "^1.38",
		"rolldown": "1.0.0-beta.58",
		"tslib": "^2.8",
		"typescript": "^5.9",
		"vite": "8.0.0-beta.5",
		"vitest": "^4"
	},
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./dist/index.js"
		},
		"./add": {
			"types": "./types/add.d.ts",
			"default": "./dist/add.js"
		},
		"./compare": {
			"types": "./types/compare.d.ts",
			"default": "./dist/compare.js"
		},
		"./constants": {
			"types": "./types/constants.d.ts",
			"default": "./dist/constants.js"
		},
		"./get": {
			"types": "./types/get.d.ts",
			"default": "./dist/get.js"
		},
		"./is": {
			"types": "./types/is.d.ts",
			"default": "./dist/is.js"
		},
		"./models": {
			"types": "./types/models.d.ts"
		},
		"./parse": {
			"types": "./types/parse.d.ts",
			"default": "./dist/parse.js"
		},
		"./relative": {
			"types": "./types/relative.d.ts",
			"default": "./dist/relative.js"
		},
		"./subtract": {
			"types": "./types/subtract.d.ts",
			"default": "./dist/subtract.js"
		}
	},
	"files": [
		"dist",
		"src",
		"types"
	],
	"keywords": [
		"date",
		"time",
		"utility"
	],
	"license": "MIT",
	"module": "dist/index.js",
	"name": "@oscarpalmer/datum",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarpalmer/datum.git"
	},
	"scripts": {
		"build": "npm run clean && npx vite build && npm run rolldown:build && npx tsc",
		"clean": "rm -rf ./dist && rm -rf ./types && rm -f ./tsconfig.tsbuildinfo",
		"rolldown:build": "npx rolldown -c",
		"rolldown:watch": "npx rolldown -c ./rolldown.config.js --watch",
		"test": "npx vitest --coverage",
		"watch": "npx vite build --watch"
	},
	"type": "module",
	"types": "types/index.d.ts",
	"version": "0.11.0"
}