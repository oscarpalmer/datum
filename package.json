{
	"name": "@oscarpalmer/datum",
	"version": "0.12.0",
	"description": "Dates and stuff.",
	"keywords": [
		"date",
		"time",
		"utility"
	],
	"license": "MIT",
	"author": {
		"name": "Oscar Palmér",
		"url": "https://oscarpalmer.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarpalmer/datum.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"types": "dist/index.d.mts",
	"exports": {
		"./add": {
			"types": "./dist/add.d.mts",
			"default": "./dist/add.mjs"
		},
		"./compare": {
			"types": "./dist/compare.d.mts",
			"default": "./dist/compare.mjs"
		},
		"./constants": {
			"types": "./dist/constants.d.mts",
			"default": "./dist/constants.mjs"
		},
		"./get": {
			"types": "./dist/get.d.mts",
			"default": "./dist/get.mjs"
		},
		"./is": {
			"types": "./dist/is.d.mts",
			"default": "./dist/is.mjs"
		},
		"./models": {
			"types": "./dist/models.d.mts"
		},
		"./parse": {
			"types": "./dist/parse.d.mts",
			"default": "./dist/parse.mjs"
		},
		"./relative": {
			"types": "./dist/relative.d.mts",
			"default": "./dist/relative.mjs"
		},
		"./subtract": {
			"types": "./dist/subtract.d.mts",
			"default": "./dist/subtract.mjs"
		}
	},
	"scripts": {
		"build": "npm run tsdown && npx vp pack",
		"test": "npx vp test run --coverage",
		"test:leak": "npx vp test run --detect-async-leaks --coverage",
		"tsdown": "npx tsdown -c ./tsdown.config.ts",
		"watch": "npx tsdown -c ./tsdown.config.ts --watch"
	},
	"dependencies": {
		"@oscarpalmer/atoms": "^0.205"
	},
	"devDependencies": {
		"@types/node": "^26.6",
		"@vitest/coverage-istanbul": "5.0.1",
		"jsdom": "^30.1",
		"tsdown": "^0.23",
		"typescript": "^7",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0",
		"vitest": "5.0.1"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vitest": "5.0.1"
	}
}